{
  "servers": {
    "mcp-blueprint": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "mcp-blueprint"
      ],
      "cwd": "${workspaceFolder}/dev/mcp-blueprint",
      "env": {
        "BLUEPRINT_DATA_DIR": "${workspaceFolder}/dev/mcp-blueprint/data"
      }
    },
    "mcp-postgres": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "mcp-postgres"
      ],
      "cwd": "${workspaceFolder}/data/mcp-postgres"
    },
    "mcp-redis": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "mcp-redis"
      ],
      "cwd": "${workspaceFolder}/data/mcp-redis"
    },
    "mcp-storage": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "mcp-storage"
      ],
      "cwd": "${workspaceFolder}/data/mcp-storage"
    },
    "mcp-auth": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "mcp-auth"
      ],
      "cwd": "${workspaceFolder}/business/mcp-auth"
    },
    "mcp-user-mgmt": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "mcp-user-mgmt"
      ],
      "cwd": "${workspaceFolder}/business/mcp-user-mgmt"
    }
  }
}
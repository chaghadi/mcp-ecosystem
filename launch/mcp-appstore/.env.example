# App Store Connect → Users and Access → Keys → Create new key
# Download the .p8 file once — you can't download it again
APPSTORE_KEY_ID=your-key-id
APPSTORE_ISSUER_ID=your-issuer-uuid
APPSTORE_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_XXXX.p8
# OR paste contents as a single line (use \n for newlines):
# APPSTORE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

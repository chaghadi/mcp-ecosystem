# mcp-storage environment variables
# Copy to .env and fill in values. Never commit .env.

# ── Cloudflare R2 credentials ─────────────────────────────────────────────────
# Find in: Cloudflare dashboard → R2 → Manage R2 API tokens
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key

# ── Buckets ───────────────────────────────────────────────────────────────────
# Default bucket used when no bucket is specified in a tool call
R2_DEFAULT_BUCKET=mmiri28-private

# ── Public domain ─────────────────────────────────────────────────────────────
# For public buckets — set to your R2.dev subdomain or custom domain
# R2.dev format:  https://pub-abc123.r2.dev
# Custom domain:  https://assets.mmiri28.com
# Leave empty if you have no public bucket yet
R2_PUBLIC_DOMAIN=

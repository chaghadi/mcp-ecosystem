# mcp-redis environment variables
# Copy to .env and fill in values. Never commit .env.

# ── Redis connection ──────────────────────────────────────────────────────────
# Upstash (current): find in Upstash console → your database → Connect → .env
# Format: rediss://default:[PASSWORD]@[ENDPOINT]:[PORT]
#
# DigitalOcean (future): find in DO dashboard → Databases → Connection String
# Format: rediss://default:[PASSWORD]@[HOST]:[PORT]
#
REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379

# ── Key prefix ────────────────────────────────────────────────────────────────
# Namespace all keys to avoid collisions when sharing a Redis instance.
# Default: mmiri28
KEY_PREFIX=mmiri28

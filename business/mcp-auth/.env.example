# mcp-auth environment variables
# Copy to .env and fill in values. Never commit .env.

# ── Database (same Supabase instance as mcp-postgres) ─────────────────────────
DATABASE_URL=postgresql://postgres.your-project:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# ── Redis (same Upstash instance as mcp-redis) ────────────────────────────────
REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-hex-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Superadmin ────────────────────────────────────────────────────────────────
# Email of the first superadmin account (auto-assigned on register)
SUPERADMIN_EMAIL=chaghadi@mmiri28.com

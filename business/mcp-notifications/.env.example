# mcp-notifications environment variables

# ── Email — Resend ────────────────────────────────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=noreply@mmiri28.com

# ── SMS International — Twilio ────────────────────────────────────────────────
# console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1your-twilio-number

# ── SMS Nigeria — Termii ──────────────────────────────────────────────────────
# termii.com → Dashboard → API Keys
# Auto-used when recipient number starts with +234
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=mmiri28
